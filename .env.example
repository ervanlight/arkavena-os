# Copy to .env.local and fill in. Never commit .env.local.
#
# For local development these are the fixed values printed by `supabase start`.
# They are development-only keys against a database on your own machine.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role bypasses RLS. Server-side system jobs only -- never imported by
# anything under src/app or src/modules/*/components. See ARCHITECTURE.md 1.1.
SUPABASE_SERVICE_ROLE_KEY=

# Where magic links send the user back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Direct Postgres connection, used only by the db test suite.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# No AI keys. The ai-scribe module is frozen -- see ARCHITECTURE.md 9, D7.
