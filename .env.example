# Copy to .env.local and fill in. Never commit .env.local.
#
# Local development targets the shared Supabase Cloud dev project
# (buildtrust-os-dev), not a local stack -- see ADR 0006. Get these from the
# Supabase dashboard: Project Settings -> API for the URL and anon key,
# Project Settings -> Database -> Connection string for the DB URL.

NEXT_PUBLIC_SUPABASE_URL=https://rwdftlsbdkcktoeeixle.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role bypasses RLS. Server-side system jobs only -- never imported by
# anything under src/app or src/modules/*/components. See ARCHITECTURE.md 1.1.
SUPABASE_SERVICE_ROLE_KEY=

# Where magic links send the user back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Session pooler (port 5432), used by the db test suite -- NOT the port 6543
# transaction pooler, and NOT the plain direct connection either. The tests
# rely on set_config persisting across statements on one physical connection to
# impersonate a signed-in user; the transaction pooler does not guarantee that,
# and the direct connection (db.<ref>.supabase.co) is IPv6-only on this tier --
# unreachable if your network has no IPv6 route. Get this from the "Connect"
# button in the dashboard toolbar, "Session pooler" tab. Note the username
# changes to postgres.<ref> for pooler connections. See ADR 0006 addendum.
SUPABASE_DB_URL=postgresql://postgres.rwdftlsbdkcktoeeixle:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Personal access token, scoped to your WHOLE Supabase account, not just this
# project -- a materially bigger blast radius than the DB password above. Used
# only by `pnpm db:types`, which calls the Management API instead of spinning
# up a local postgres-meta container. Create at
# supabase.com/dashboard/account/tokens; revocable any time. See ADR 0006
# addendum for why --db-url could not be used here instead.
SUPABASE_ACCESS_TOKEN=

# No AI keys. The ai-scribe module is frozen -- see ARCHITECTURE.md 9, D7.
