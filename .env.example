# Copy to .env.local and fill in. Never commit .env.local.
#
# Local development targets the shared Supabase Cloud dev project
# (buildtrust-os-dev), not a local stack -- see ADR 0006. Get these from the
# Supabase dashboard: Project Settings -> API for the URL and anon key,
# Project Settings -> Database -> Connection string for the DB URL.

NEXT_PUBLIC_SUPABASE_URL=https://rwdftlsbdkcktoeeixle.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role bypasses RLS. Server-side system jobs only -- never imported by
# anything under src/app or src/modules/*/components. See ARCHITECTURE.md 1.1.
SUPABASE_SERVICE_ROLE_KEY=

# Where magic links send the user back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Direct connection (port 5432), used by the db test suite -- NOT the port 6543
# transaction pooler. The tests rely on set_config persisting across statements
# on one physical connection to impersonate a signed-in user; the pooler does
# not guarantee that. Get this from Database -> Connection string -> URI,
# "Direct connection" tab.
SUPABASE_DB_URL=postgresql://postgres:[password]@db.rwdftlsbdkcktoeeixle.supabase.co:5432/postgres

# No AI keys. The ai-scribe module is frozen -- see ARCHITECTURE.md 9, D7.
