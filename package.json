{
  "name": "buildtrust-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "db:push": "supabase db push --db-url \"$SUPABASE_DB_URL\"",
    "db:types": "supabase gen types typescript --project-id rwdftlsbdkcktoeeixle --schema public > src/core/db/database.types.ts",
    "db:types:check": "tsx scripts/check-db-types.ts",
    "gen:rls-check": "tsx scripts/rls-check.ts",
    "verify:boundaries": "tsx scripts/verify-boundaries.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.7",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "eslint-config-next": "16.2.10",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.0.2",
    "pg": "8.22.0",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
